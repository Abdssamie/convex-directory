# @defaultSensitive=inferFromPrefix(PUBLIC_)
# @defaultRequired=infer
# @generateTypes(lang=ts, path=src/lib/convex/convex-env.d.ts)
# @redactLogs=true
# @preventLeaks=true
# ---

# ====================================
# Better Auth
# ====================================

# Secret for signing sessions and tokens
# @required @sensitive
BETTER_AUTH_SECRET=

# Base URL for OAuth redirects and deep links
# @type=url @required
SITE_URL=

# ====================================
# Email System (Brevo)
# ====================================

# Brevo API key for transactional email delivery
# @required @sensitive
BREVO_API_KEY=

# Display name shown as email sender
# @required
BREVO_SENDER_NAME=

# Verified sender email address (must be verified in Brevo dashboard)
# @required
BREVO_SENDER_EMAIL=

# Optional reply-to address (falls back to BREVO_SENDER_EMAIL)
# @optional
BREVO_REPLY_TO_EMAIL=

# Brevo webhook HMAC-SHA256 secret for event verification
# Set in Brevo dashboard: Settings → Tracking → Webhooks
# @optional @sensitive
BREVO_WEBHOOK_SECRET=

# Production URL for email assets (logo images, footer links)
# Must always be a public domain (email clients cannot access localhost)
# @type=url @required
EMAIL_ASSET_URL=

# ====================================
# Polar Billing (TODO — MVP is free)
# ====================================

# Polar Organization Access Token
# Get from: https://polar.sh → Settings → Developers → Access Tokens
# Not required for MVP — all features are free
# @optional @sensitive
POLAR_ORGANIZATION_TOKEN=

# Polar Webhook Secret (for subscription state sync)
# Get from: Polar dashboard → Webhooks when setting up
# @optional @sensitive
POLAR_WEBHOOK_SECRET=

# Polar server environment (sandbox | production). Defaults to sandbox if unset.
# Uncomment and add to .env-convex.schema when going to production.
# POLAR_SERVER=sandbox

# ====================================
# AI Support
# ====================================

# OpenRouter API key for AI-powered support chat
# @required @sensitive
OPENROUTER_API_KEY=

# ====================================
# OAuth Providers
# ====================================

# Google OAuth
# @optional
AUTH_GOOGLE_ID=

# @optional @sensitive
AUTH_GOOGLE_SECRET=

# GitHub OAuth
# @optional
AUTH_GITHUB_ID=

# @optional @sensitive
AUTH_GITHUB_SECRET=

# ====================================
# E2E Testing
# ====================================

# Secret for test mutations (never set in production)
# @optional @sensitive
AUTH_E2E_TEST_SECRET=

# ====================================
# Preview Dev (auto-seeded on preview deployments)
# ====================================

# Password for the auto-seeded preview admin (admin@preview.dev)
# Only set on preview Convex deployments by deploy.ts
# @optional @sensitive
PREVIEW_ADMIN_PASSWORD=

# ====================================
# Local Dev (auto-generated by vite.config.ts)
# ====================================

# Flag indicating local Convex dev mode
# @type=boolean @optional
LOCAL_CONVEX_DEV=

# Seeded admin credentials for local dev
# @optional
LOCAL_SEEDED_ADMIN_EMAIL=

# @optional @sensitive
LOCAL_SEEDED_ADMIN_PASSWORD=

# @optional
LOCAL_SEEDED_ADMIN_NAME=
