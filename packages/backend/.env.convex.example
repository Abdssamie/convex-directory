# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-auth-secret-base64-here

SITE_URL=http://localhost:3001
AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Brevo (get from https://app.brevo.com/settings/keys)
BREVO_API_KEY=your-brevo-api-key
BREVO_WEBHOOK_TOKEN=random-token-for-webhook-verification

BREVO_APP_NAME="Your App Name"

BREVO_SENDER_EMAIL=from@yourdomain.com

BREVO_SENDER_NAME="Your Sender Name"

BREVO_REPLY_TO_EMAIL=support@yourdomain.com

BREVO_REPLY_TO_NAME="Support"

# Cloudflare R2 (optional, for file storage)
R2_TOKEN=r2-token-here
R2_ACCESS_KEY_ID=key-id-here
R2_SECRET_ACCESS_KEY=secret-key-here
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_BUCKET=bucket-name

# Polar (get from https://app.polar.io/settings/organization)
POLAR_ORGANIZATION_TOKEN=polar_oat_xxx
POLAR_WEBHOOK_SECRET=polar_whs_xxx
POLAR_SERVER=sandbox
