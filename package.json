{
  "name": "convex-zen",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter web --filter @convex-zen/backend dev",
    "dev:all": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --filter=web --filter=@convex-zen/ui typecheck",
    "lint": "oxlint && oxfmt --write",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter @convex-zen/backend dev",
    "dev:setup": "pnpm --filter @convex-zen/backend dev:setup",
    "deploy": "pnpm --filter @convex-zen/infra deploy",
    "destroy": "pnpm --filter @convex-zen/infra destroy",
    "prepare": "husky",
    "convex-env-sync": "cd packages/backend && npx convex env set --from-file .env.convex",
    "brevo": "pnpm --filter @convex-zen/backend brevo",
    "brevo:list": "pnpm brevo list",
    "brevo:sync": "pnpm brevo sync"
  },
  "dependencies": {
    "@convex-zen/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@convex-zen/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*": [
      "oxlint",
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@10.30.3"
}
