{
  "name": "convex-directory",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --stream --filter web --filter @convex-directory/backend dev",
    "dev:all": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --filter=web --filter=@convex-directory/ui typecheck",
    "lint": "oxlint && oxfmt --write",
    "sync:project-config": "node scripts/sync-project-config.mjs",
    "doctor:deploy": "node scripts/deploy-doctor.mjs",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter @convex-directory/backend dev",
    "dev:setup": "pnpm --filter @convex-directory/backend dev:setup",
    "deploy": "pnpm run deploy:backend && pnpm run deploy:web",
    "deploy:web": "pnpm --filter web deploy",
    "deploy:backend": "pnpm --filter @convex-directory/backend deploy",
    "destroy": "pnpm --filter web destroy",
    "prepare": "husky",
    "convex-env-sync": "cd packages/backend && npx convex env set --from-file .env.convex",
    "secrets:verify": "node scripts/verify-secrets.mjs",
    "secrets:push": "pnpm secrets:verify && gh secret set --env-file .env.secrets",
    "brevo": "pnpm --filter @convex-directory/backend brevo",
    "brevo:list": "pnpm brevo list",
    "brevo:sync": "pnpm brevo sync"
  },
  "dependencies": {
    "@convex-directory/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@convex-directory/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "^5",
    "wrangler": "^4.83.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,jsonc}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
